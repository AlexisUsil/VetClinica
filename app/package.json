{
  "name": "vetclinica-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:multi": "tsc -b && vite build --mode multi",
    "preview": "vite preview --port 4317 --strictPort",
    "data": "python ../build_data.py && node -e \"require('fs').copyFileSync('../data/dashboard.json','src/data/dashboard.json')\"",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "@number-flow/react": "^0.6.2",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.47.0",
    "maplibre-gl": "^6.11.1",
    "motion": "^13.4.2",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.0",
