   "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2twelpFRXdOV0pQYzBObGJWSTJNbTFWWmtOa1NXYxAB!2m1!1s0x9105b767d026f29f:0x86cd998ed5ecda1f"
