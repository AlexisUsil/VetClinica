   "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT25GWWJVSlVWbXhaVVhGYWJqVklSVTF1WlRoRGVFRRAB!2m1!1s0x9105c965f8edf1c7:0x655566b7306d628f"
