   "publishTime": "2025-08-20T14:59:43.896199317Z",
   "flagContentUri": "https://www.google.com/local/content/rap/report?postId=Ci9DQUlRQUNvZENodHljRjlvT2xsRFRIQlFaelpCWldNM05tUTJMVlJ0U25KVU1uYxAB&d=17924085&t=1",
   "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xsRFRIQlFaelpCWldNM05tUTJMVlJ0U25KVU1uYxAB!2m1!1s0x9105b92e083741a3:0x6fe849a92f1b46b1"
