   "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT25aWFVYUjVaMUZ3YkZoTWFVaHhNSGh4YzFwVGRsRRAB!2m1!1s0x9105c93c9077501f:0x7034d230f39ea447"
