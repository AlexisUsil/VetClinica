   "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT21jeVFsRmZaazExYW5FMlpVSlpNekJ1TW1nd1FsRRAB!2m1!1s0x9105b9055f9d809b:0xac36b6bdd766e3e7"
