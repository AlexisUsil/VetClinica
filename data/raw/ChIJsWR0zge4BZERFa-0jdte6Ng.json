   "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2tWUFRuUkxhM2hKUWpsUVNTMXBXa0pUWkRkcU9YYxAB!2m1!1s0x9105b807ce7464b1:0xd8e85edb8db4af15"
