 "reviews": [
  {
   "name": "places/ChIJA1qEfpjHBZERJD0BZpFXW7k/reviews/ChdDSUhNMG9nS0VJQ0FnSURFeklpbTN3RRAB",
   "relativePublishTimeDescription": "Hace 7 años",
   "rating": 4,
   "text": {
    "text": "Veterinaria con bastantes años de experiencia, muy buen trato con especialistas. Atención de buena calidad. En cuanto a precios, cara, talvez junto con la veterinaria Rondon una de las más caras de todo Lima. Atención las 24 horas. Solo atiendes perros y gatos. Solo cuenta con 3 estacionamientos. Se puede realizar pagos con visa o MasterCard.",
    "languageCode": "es"
   },
   "originalText": {
    "text": "Veterinaria con bastantes años de experiencia, muy buen trato con especialistas. Atención de buena calidad. En cuanto a precios, cara, talvez junto con la veterinaria Rondon una de las más caras de todo Lima. Atención las 24 horas. Solo atiendes perros y gatos. Solo cuenta con 3 estacionamientos. Se puede realizar pagos con visa o MasterCard.",
    "languageCode": "es"
   },
   "authorAttribution": {
    "displayName": "Guillermo Rodríguez",
