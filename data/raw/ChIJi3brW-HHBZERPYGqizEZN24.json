   "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT21aQmNXdFBVVTVGT1Vab0xVRkZUMlZzZG1aSFgwRRAB!2m1!1s0x9105c7e15beb768b:0x6e3719318baa813d"
