   "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChZDSUhNMG9nS0VJQ0FnSURhejVYWlJBEAE!2m1!1s0x9105c687e7419e07:0x72a153f5d999915"
