   "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2paMGJubDVUVWxwYkhsTmQxVkhSMDVITFRaeVJrRRAB!2m1!1s0x9105b806c287fc85:0x788292c975bfb253"
