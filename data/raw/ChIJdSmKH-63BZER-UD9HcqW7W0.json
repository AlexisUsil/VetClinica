   "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xnMGFXNDBhWHB5WW5WMlRETjVOSEphUlRoVVVIYxAB!2m1!1s0x9105b7ee1f8a2975:0x6ded96ca1dfd40f9"
