   "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChdDSUhNMG9nS0VJQ0FnSUNYcHV1SzJRRRAB!2m1!1s0x9105c9ab13e2329f:0x392fec3d02b601c2"
