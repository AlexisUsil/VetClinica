   "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChZDSUhNMG9nS0VJQ0FnTUNBdHB6ZEpBEAE!2m1!1s0x9105b9482894bd27:0x157fe961a8b64426"
