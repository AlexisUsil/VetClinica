   "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT25CbGNucFRaSE5sZERZM1IwMUZOVkZaYUZZeWNHYxAB!2m1!1s0x9105c9dba4cbafe7:0xfcd4d07e4671bf6"
