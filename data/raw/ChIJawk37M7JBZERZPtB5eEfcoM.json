  {
   "name": "places/ChIJawk37M7JBZERZPtB5eEfcoM/reviews/ChZDSUhNMG9nS0VJQ0FnSUQ2Ml82NkR3EAE",
   "relativePublishTimeDescription": "Hace 4 años",
   "rating": 5,
   "text": {
    "text": "Excelente servicio, atienden feriados siempre con cita, tienda con muchos artículos para gatos y perros, atención personalizada, no hay estacionamiento, tienen medios de pagos con yape, o transferencia de cuenta.\nBrindan asesoría para el cuidado de su mascota.",
    "languageCode": "es"
   },
