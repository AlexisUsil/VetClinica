   "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2pWU2VWUjRjVk5PUzFZMVYyNWljelUzV25WaFExRRAB!2m1!1s0x9105c79843751357:0xa94290bb9fd375e6"
