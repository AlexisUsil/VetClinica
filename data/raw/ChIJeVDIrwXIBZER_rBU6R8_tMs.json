   "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChdDSUhNMG9nS0VJQ0FnSUNMaXVHZXhRRRAB!2m1!1s0x9105c805afc85079:0xcbb43f1fe954b0fe"
