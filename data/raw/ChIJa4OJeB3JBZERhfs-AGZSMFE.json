 "reviews": [
  {
   "name": "places/ChIJa4OJeB3JBZERhfs-AGZSMFE/reviews/ChdDSUhNMG9nS0VJQ0FnSUNYa3FpNGhRRRAB",
   "relativePublishTimeDescription": "Hace un año",
   "rating": 1,
   "text": {
    "text": "Vivía a la espalda de esa veterinaria. Mi perro se cortó la pata con un vidrio de la puerta y la herida era enorme.  Fui corriendo y les pedí que vayan a verlo para contener la herida o sedarlo para poder movilizarlo porque era un perro grande que no podía cargar, pero tan solo me indicaron que no daban ese servicio.  Demasiado desinterés.",
    "languageCode": "es"
   },
   "originalText": {
    "text": "Vivía a la espalda de esa veterinaria. Mi perro se cortó la pata con un vidrio de la puerta y la herida era enorme.  Fui corriendo y les pedí que vayan a verlo para contener la herida o sedarlo para poder movilizarlo porque era un perro grande que no podía cargar, pero tan solo me indicaron que no daban ese servicio.  Demasiado desinterés.",
    "languageCode": "es"
   },
