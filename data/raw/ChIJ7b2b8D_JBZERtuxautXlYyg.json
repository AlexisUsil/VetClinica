    "uri": "https://www.google.com/maps/contrib/101267413042712697354/reviews",
    "photoUri": "https://lh3.googleusercontent.com/a-/ALV-UjU5K2QWeU1skPhxQEZ7gORUKw3oUFgclk2bi3pnd7sWdciphfIQ=s128-c0x00000000-cc-rp-mo"
