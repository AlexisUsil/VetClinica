   "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChZDSUhNMG9nS0VJQ0FnSUNiazlPcGZREAE!2m1!1s0x9105c93ff09bbded:0x2863e5d5ba5aecb6"
