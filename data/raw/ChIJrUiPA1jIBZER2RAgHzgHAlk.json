   "flagContentUri": "https://www.google.com/local/content/rap/report?postId=Ci9DQUlRQUNvZENodHljRjlvT2pGUWNFRlRkblpvTmpOME1IRk1TMGhyWm5ZemRWRRAB&d=17924085&t=1",
   "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2pGUWNFRlRkblpvTmpOME1IRk1TMGhyWm5ZemRWRRAB!2m1!1s0x9105c858038f48ad:0x590207381f2010d9"
