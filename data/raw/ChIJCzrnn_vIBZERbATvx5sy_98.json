  {
   "name": "places/ChIJCzrnn_vIBZERbATvx5sy_98/reviews/Ci9DQUlRQUNvZENodHljRjlvT2sxMk5HTjBXVzlXYWpVdFVHNVJhazloZWtVNFNFRRAB",
   "relativePublishTimeDescription": "Hace 4 meses",
   "rating": 5,
   "text": {
