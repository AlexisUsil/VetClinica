   "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChdDSUhNMG9nS0VJQ0FnSURYcU1mR3FBRRAB!2m1!1s0x9105c9b1017757c1:0x681e92900c720a7c"
