   "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2pjMFpESTRUa2xYZVdwa1pXTTNUMU5CVm5SS1gzYxAB!2m1!1s0x9105b9e3e7a91f7b:0x26ec618561b6340d"
