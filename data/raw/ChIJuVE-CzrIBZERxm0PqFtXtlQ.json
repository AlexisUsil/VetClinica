   "flagContentUri": "https://www.google.com/local/content/rap/report?postId=ChZDSUhNMG9nS0VJQ0FnSUM4NjgzVUl3EAE&d=17924085&t=1",
   "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChZDSUhNMG9nS0VJQ0FnSUM4NjgzVUl3EAE!2m1!1s0x9105c83a0b3e51b9:0x54b6575ba80f6dc6"
