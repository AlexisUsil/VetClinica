   "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT21OUVgydE9PVGRwU1ZkdWIxY3lOekJuY0ZwUmFYYxAB!2m1!1s0x9105c7f93ea0dae9:0x7d0445e6966c134f"
