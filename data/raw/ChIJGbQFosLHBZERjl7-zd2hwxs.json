   "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT21OSFJqRTJiMDR0TTBkd2JVUjFObFYwYlZaeFRsRRAB!2m1!1s0x9105c7c2a205b419:0x1bc3a1ddcdfe5e8e"
