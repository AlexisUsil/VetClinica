   "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2xvNUxYaGZRbUZvTmpOMloxVm9RWEJEVDBkUE0yYxAB!2m1!1s0x9105c71123156919:0x907a409831ce339d"
