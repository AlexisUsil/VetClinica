   "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2tsTlYwcFdZbkZ6ZFVoMVpFNVNZbnBwTms1M05WRRAB!2m1!1s0x9105c83a81adca93:0xd8b7788114b65646"
