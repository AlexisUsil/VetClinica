 "reviews": [
  {
   "name": "places/ChIJudIQSufHBZERPspkD0wuN7s/reviews/ChZDSUhNMG9nS0VJQ0FnSUNVaWF5d1lREAE",
   "relativePublishTimeDescription": "Hace 7 años",
   "rating": 1,
   "text": {
    "text": "Malisima atención. Saqué cita el viernes para baño y corte de mis dos mascotas para el domingo. Me pidieron que fuera a las 10.00 am el domingo, que fuera puntual. Llegué a las 10. 00 y estaba cerrado. El personal llegó a las 10.20 recién a preparar todo para atender. Después me dicen que el que  corta el pelo no iba a ir a trabajar. Yo había dejado mi celular para q me avisaran con anticipación si pasaba algo. Al quejarme contestaron con mala actitud. No tienen libro de reclamaciones. Nunca más. Les falta un curso de atención al cliente. Las empresas deben esperar al cliente no lo contrario.",
    "languageCode": "es"
   },
   "originalText": {
    "text": "Malisima atención. Saqué cita el viernes para baño y corte de mis dos mascotas para el domingo. Me pidieron que fuera a las 10.00 am el domingo, que fuera puntual. Llegué a las 10. 00 y estaba cerrado. El personal llegó a las 10.20 recién a preparar todo para atender. Después me dicen que el que  corta el pelo no iba a ir a trabajar. Yo había dejado mi celular para q me avisaran con anticipación si pasaba algo. Al quejarme contestaron con mala actitud. No tienen libro de reclamaciones. Nunca más. Les falta un curso de atención al cliente. Las empresas deben esperar al cliente no lo contrario.",
    "languageCode": "es"
   },
