   "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChZDSUhNMG9nS0VJQ0FnSURicVpxd2ZBEAE!2m1!1s0x9105c9df54be911b:0x4fa6a7957992bc8e"
