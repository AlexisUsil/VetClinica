 "reviews": [
  {
   "name": "places/ChIJByMWrRvIBZERA4SFRe9K4IU/reviews/ChZDSUhNMG9nS0VJQ0FnSUNZNnZtX09BEAE",
   "relativePublishTimeDescription": "Hace 7 años",
   "rating": 4,
   "text": {
    "text": "Es un lugar confiable, hasta ahora no he tenido problemas con mí mascota, la tratan con mucho cariño cada vez que la llevó a bañar , los precios son adecuados. La atención de los médicos también es buena, no cobran en exceso y dan diagnósticos asertivos. Por otro lado, creo que ayudaría que atiendan hasta más tarde en las noches ! Pero en general, lo recomiendo",
    "languageCode": "es"
   },
   "originalText": {
