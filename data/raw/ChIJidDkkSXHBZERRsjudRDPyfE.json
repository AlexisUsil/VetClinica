 "reviews": [
  {
   "name": "places/ChIJidDkkSXHBZERRsjudRDPyfE/reviews/ChZDSUhNMG9nS0VJQ0FnSUROcmV5bFl3EAE",
   "relativePublishTimeDescription": "Hace 2 años",
   "rating": 5,
   "text": {
    "text": "Lindo lugar! La veterinaria está ubicada en un lugar muy céntrico, muy limpia y bien decorada, tiene un lugar de espera y está bien señalizado. Me gustó que la atención fuese muy rápida por redes sociales. Fui por una profilaxis para mi perrita y todo salió muy bien; me la entregaron bastante despierta, por lo que asumo que la dosis de anestesia ha sido muy bien controlada.",
    "languageCode": "es"
   },
   "originalText": {
    "text": "Lindo lugar! La veterinaria está ubicada en un lugar muy céntrico, muy limpia y bien decorada, tiene un lugar de espera y está bien señalizado. Me gustó que la atención fuese muy rápida por redes sociales. Fui por una profilaxis para mi perrita y todo salió muy bien; me la entregaron bastante despierta, por lo que asumo que la dosis de anestesia ha sido muy bien controlada.",
    "languageCode": "es"
   },
