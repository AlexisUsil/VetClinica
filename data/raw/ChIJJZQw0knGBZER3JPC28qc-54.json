  {
   "name": "places/ChIJJZQw0knGBZER3JPC28qc-54/reviews/ChZDSUhNMG9nS0VJQ0FnSURrMlliZ1B3EAE",
   "relativePublishTimeDescription": "Hace 7 años",
   "rating": 4,
   "text": {
    "text": "Excelente atención. Las doctoras son excelentes, muy detallistas y meticulosas en la revisión, evaluación y tratamiento de tus mascotas. También brindan servicios de baños medicados, alojamiento y cirugías. Ojo, NO atienden emergencias 24 horas, tampoco atienden los domingos.",
    "languageCode": "es"
   },
