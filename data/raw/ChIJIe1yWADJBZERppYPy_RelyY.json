   "flagContentUri": "https://www.google.com/local/content/rap/report?postId=ChZDSUhNMG9nS0VJQ0FnSUNMcWFibUh3EAE&d=17924085&t=1",
   "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChZDSUhNMG9nS0VJQ0FnSUNMcWFibUh3EAE!2m1!1s0x9105c9005872ed21:0x26975ef4cb0f96a6"
