   "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChZDSUhNMG9nS0VJQ0FnSUNXb05DWkhnEAE!2m1!1s0x9105c0dec90096d1:0xeceabfc7fc4b2f11"
