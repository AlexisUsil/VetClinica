   "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT21aWVVreFVhV0ZRVEZWQ1VVaGlhbW94TFcxbFkwRRAB!2m1!1s0x9105c9003fa9aba5:0x72a503bd23f838a8"
