   "flagContentUri": "https://www.google.com/local/content/rap/report?postId=ChdDSUhNMG9nS0VJQ0FnSURSNU9YQmhBRRAB&d=17924085&t=1",
   "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sChdDSUhNMG9nS0VJQ0FnSURSNU9YQmhBRRAB!2m1!1s0x9105c9990e0a3309:0xd271e16f20664cef"
