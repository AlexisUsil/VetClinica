   },
   "publishTime": "2026-02-08T01:59:23.993221361Z",
   "flagContentUri": "https://www.google.com/local/content/rap/report?postId=Ci9DQUlRQUNvZENodHljRjlvT2pVelFuQmFRblpKWmpRd2VXSTJUVlJEUXpscGJsRRAB&d=17924085&t=1",
   "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2pVelFuQmFRblpKWmpRd2VXSTJUVlJEUXpscGJsRRAB!2m1!1s0x9105c83cefb91075:0xc6944fddbf696a3f"
