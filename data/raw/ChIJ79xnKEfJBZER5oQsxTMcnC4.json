   "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2pOUVpEUnBaVU5CTlc1TmJFbGFaWEZPVWxSeGJtYxAB!2m1!1s0x9105c9472867dcef:0x2e9c1c33c52c84e6"
