   "googleMapsUri": "https://www.google.com/maps/reviews/data=!4m6!14m5!1m4!2m3!1sCi9DQUlRQUNvZENodHljRjlvT2tGV01WQk5OeloyZG5kNWFqSmFiM1E0VUZkVWNFRRAB!2m1!1s0x9105c74309e988f5:0xa51e631d612605df"
